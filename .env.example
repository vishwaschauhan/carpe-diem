# Firebase web app config: Firebase console → Project settings → Your apps → Web app.
# These identify your project; they are not secrets. Access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Auth and Firestore emulators (npm run emulators).
VITE_USE_EMULATORS=false
