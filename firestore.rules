rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's Carpe Diem data lives under users/{uid}; only they can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && collection in ['tasks', 'goals', 'blocks', 'sessions', 'parked', 'days'];
      }
    }
  }
}
